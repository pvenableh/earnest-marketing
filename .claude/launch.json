{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "marketing-dev",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-c",
        "source ~/.zshrc && pnpm dev"
      ],
      "port": 3001,
      "url": "http://localhost:3001",
      "autoPort": true
    },
    {
      "name": "mockups",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
        "mockups",
        "--bind",
        "127.0.0.1"
      ],
      "port": 4173,
      "url": "http://localhost:4173"
    }
  ]
}
